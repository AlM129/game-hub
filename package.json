{
  "name": "game-hub",
  "productName": "Game Hub",
  "version": "2.0.0",
  "description": "Game Hub - A launcher for games",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac --x64 --arm64",
    "dist:mac:x64": "electron-builder --mac --x64",
    "dist:mac:arm64": "electron-builder --mac --arm64",
    "dist:mac:universal": "electron-builder --mac --universal",
    "test": "playwright test",
    "test:smoke": "playwright test tests/launcher.spec.js tests/games.spec.js tests/bridge.spec.js"
  },
  "build": {
    "appId": "com.gamehub.app",
    "productName": "Game Hub",
    "extraResources": [
      {
        "from": "src/updater/macExternalUpdater.js",
        "to": "src/updater/macExternalUpdater.js"
      },
      {
        "from": "node_modules/adm-zip",
        "to": "node_modules/adm-zip"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.icns",
      "identity": null
    },
    "publish": {
      "provider": "github",
      "owner": "AlM129",
      "repo": "game-hub"
    }
  },
  "keywords": [],
  "author": "MCM Games",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/cli": "^4.3.2",
    "autoprefixer": "^10.5.2",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9"
  }
}
